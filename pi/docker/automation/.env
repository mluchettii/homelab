# Automation stack environment variables

# Subnet for the automation stack network
AUTOMATION_SUBNET=172.31.0.0/16

# N8n
N8N_USER=admin
N8N_PW=change_me
N8N_URL=http://localhost:5678
N8N_PORT=5678

# Ollama
OLLAMA_DOCKER_TAG=latest
OLLAMA_PORT=11434

# Open WebUI
WEBUI_DOCKER_TAG=main
OPEN_WEBUI_PORT=3020
WEBUI_SECRET_KEY=change_me

# NTFY
NTFY_DOMAIN=ntfy.example.com
NTFY_HTTP_PORT=8015
NTFY_HTTPS_PORT=9015
NTFY_TOPIC=homelab-alerts
NTFY_TOKEN=change_me-generate-with-ntfy-token-generate

# LoggiFly
LOGGIFY_UID=1000
LOGGIFY_GID=1000
SOCKET_PROXY_UID=0
SOCKET_PROXY_GID=984
