# Home Server Docker Compose — Environment Variables Reference
#
# Copy the relevant section from each service's directory and edit the values.
# Never commit real secrets — .env files are in .gitignore.
#
# Generate secure values:
#   PG_PASS        = openssl rand -base64 36 | tr -d '\n'
#   AUTHENTIK_SECRET_KEY = openssl rand -base64 60 | tr -d '\n'
#   WEBUI_SECRET_KEY   = openssl rand -base64 60 | tr -d '\n'
#   CLOUDFLARE_DNS_API_TOKEN = generate in Cloudflare dashboard (Zone DNS:Edit)
#   TAILSCALE_AUTHKEY    = generate in Tailscale dashboard (Keys > Generate key)
#   NTFY_TOKEN           = ntfy token generate (or use a random string)

# ── Vaultwarden ──────────────────────────────────────────────────────────────
VAULTWARDEN_DOMAIN=https://vaultwarden.example.com

# ── Authentik ────────────────────────────────────────────────────────────────
PG_DB=authentik
PG_USER=authentik
PG_PASS=change_me
AUTHENTIK_SECRET_KEY=change_me
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443

# ── Tailscale ────────────────────────────────────────────────────────────────
TAILSCALE_HOSTNAME=pi
TAILSCALE_AUTHKEY=ts-auth-key-placeholder
TAILSCALE_STATE_DIR=/var/lib/tailscale
TAILSCALE_STATE_PATH=./tailscale-state

# ── Guacamole ────────────────────────────────────────────────────────────────
GUAC_DB_USER=guacadmin
GUAC_DB_PASSWORD=change_me
GUAC_DRIVE_DIR=./drive
GUAC_RECORD_DIR=./record
GUAC_PGDATA_DIR=./pgdata
GUAC_WEB_PORT=8040
# OpenID SSO (optional — set when using Authentik)
GUAC_OPENID_ENABLED=false
# GUAC_OPENID_AUTH_ENDPOINT=https://auth.example.com/oauth/authorize
# GUAC_OPENID_CLIENT_ID=guacamole
# GUAC_OPENID_ISSUER=https://auth.example.com
# GUAC_OPENID_JWKS=https://auth.example.com/application/oidc/jwks/
# GUAC_OPENID_REDIRECT=https://guacamole.example.com/guacamole/

# ── Pangolin (DigitalOcean droplet) ──────────────────────────────────────────
CROWDSEC_GID=1000
CROWDSEC_LAPI_KEY=change_me-generate-with-cscli-lapi-get-key
CROWDSEC_METRICS_PORT=6060
CROWDSEC_API_PORT=8080
CLOUDFLARE_DNS_API_TOKEN=change_me-generate-in-cloudflare-dashboard
TRAEFIK_EMAIL=admin@example.com
PANGOLIN_DOMAIN=pangolin.example.com
PANGOLIN_NETWORK=pangolin
PANGOLIN_INSTANCE_NAME=pangolin-crowdsec

# ── Automation Stack ─────────────────────────────────────────────────────────
AUTOMATION_SUBNET=172.31.0.0/16

# N8n
N8N_USER=admin
N8N_PW=change_me
N8N_URL=http://localhost:5678
N8N_PORT=5678

# Ollama
OLLAMA_DOCKER_TAG=latest
OLLAMA_PORT=11434

# Open WebUI
WEBUI_DOCKER_TAG=main
OPEN_WEBUI_PORT=3020
WEBUI_SECRET_KEY=change_me

# NTFY
NTFY_DOMAIN=ntfy.example.com
NTFY_HTTP_PORT=8015
NTFY_HTTPS_PORT=9015
NTFY_TOPIC=homelab-alerts
NTFY_TOKEN=change_me-generate-with-ntfy-token-generate

# LoggiFly
LOGGIFY_UID=1000
LOGGIFY_GID=1000
SOCKET_PROXY_UID=0
SOCKET_PROXY_GID=984

# ── Nessus ───────────────────────────────────────────────────────────────────
# Nessus runs in host network mode; no port mapping needed.
# Access at https://<pi-ip>:8834

# ── RustDesk ─────────────────────────────────────────────────────────────────
RUSTDESK_PORT_ID_RELAY=21114
RUSTDESK_PORT_ID_RELAY_UDP=21116
RUSTDESK_PORT_API=21117
RUSTDESK_PORT_RELAY=21118
RUSTDESK_PORT_TLS=21119
