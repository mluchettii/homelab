# Pangolin environment variables
# Generate before first run:
#   CLOUDFLARE_DNS_API_TOKEN = generate in Cloudflare dashboard (Zone DNS:Edit)
#   CROWDSEC_LAPI_KEY        = cscli lapi get key

CROWDSEC_GID=1000
CROWDSEC_LAPI_KEY=change_me-generate-with-cscli-lapi-get-key
CROWDSEC_METRICS_PORT=6060
CROWDSEC_API_PORT=8080
CLOUDFLARE_DNS_API_TOKEN=change_me-generate-in-cloudflare-dashboard
TRAEFIK_EMAIL=admin@example.com
PANGOLIN_DOMAIN=pangolin.example.com
PANGOLIN_NETWORK=pangolin
PANGOLIN_INSTANCE_NAME=pangolin-crowdsec
